# Copiar a app/.env.local (no se versiona).
# URL del proxy de credenciales (server/). En el teléfono usar la IP LAN de la PC, no "localhost".
EXPO_PUBLIC_PROXY_URL=http://192.168.0.10:8787
# Debe coincidir con APP_TOKEN de server/.env (opcional).
EXPO_PUBLIC_PROXY_TOKEN=
# Sólo para builds standalone de Android (APK); en Expo Go no hace falta.
GOOGLE_MAPS_API_KEY=
