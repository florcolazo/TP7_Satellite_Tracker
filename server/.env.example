# Copiar a .env (NO versionar) y completar.
PORT=8787
# https://www.n2yo.com/api/ → registrarse y generar una API key gratuita
N2YO_API_KEY=
# https://www.space-track.org/auth/createAccount
SPACETRACK_USER=
SPACETRACK_PASS=
